generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("vendedor")
  createdAt DateTime @default(now())
  ventas    Venta[]
}

model iPhone {
  id             String          @id @default(uuid())
  modelo         String
  variante       String          @default("")
  almacenamiento String
  precioBase     Decimal
  activo         Boolean         @default(true)

  variantes  IphoneVariant[]
  ventas     Venta[]
  ventaItems VentaContadoItem[]

  @@unique([modelo, variante, almacenamiento])
}

model IphoneVariant {
  id         String             @id @default(uuid())
  iphone     iPhone             @relation(fields: [iphoneId], references: [id], onDelete: Cascade)
  iphoneId   String
  color      String
  stock      Int                @default(0)
  ventas     Venta[]
  ventaItems VentaContadoItem[]

  @@unique([iphoneId, color])
  @@index([iphoneId])
}

model Cliente {
  id        String   @id @default(uuid())
  nombre    String
  apellido  String
  dni       String   @unique
  telefono  String
  email     String?
  direccion String?
  createdAt DateTime @default(now())

  ventas        Venta[]        @relation("ClienteVentas")
  reparaciones  Reparacion[]
  ventasContado VentaContado[]

  @@index([apellido, nombre])
}

model Venta {
  id                String       @id @default(uuid())
  cliente           Cliente      @relation("ClienteVentas", fields: [clienteId], references: [id])
  clienteId         String
  iphone            iPhone        @relation(fields: [iphoneId], references: [id])
  iphoneId          String
  iphoneVariant     IphoneVariant? @relation(fields: [colorId], references: [id])
  colorId           String?
  usuario           Usuario      @relation(fields: [usuarioId], references: [id])
  usuarioId         String
  precioVenta       Decimal
  anticipoEfectivo  Decimal      @default(0)
  metodoAnticipo    String       @default("efectivo") // efectivo | transferencia | tarjeta
  anticipoEquipo    Decimal      @default(0)
  descripcionEquipo String?
  planPago          String
  totalCuotas       Int
  montoCuota        Decimal
  interesPct        Decimal
  estado            String       @default("activa")
  fechaVenta        DateTime     @default(now())
  codigoOperacion   String?      @unique
  anulada           Boolean      @default(false)
  motivoAnulacion   String?
  fechaAnulacion    DateTime?
  cuotas            Cuota[]
  productoPermuta   Producto? @relation("VentaPermuta")


  @@index([fechaVenta])
  @@index([clienteId])
  @@index([colorId])
  @@index([anulada, fechaVenta])
}

model Cuota {
  id               String      @id @default(uuid())
  venta            Venta       @relation(fields: [ventaId], references: [id])
  ventaId          String
  numeroCuota      Int
  montoOriginal    Decimal
  montoMora        Decimal     @default(0)
  fechaVencimiento DateTime
  fechaPago        DateTime?
  estado           String      @default("pendiente")
  pagos            PagoCuota[]

  @@index([ventaId])
  @@index([estado, fechaVencimiento])
  @@index([fechaPago])
}

model Configuracion {
  id          String  @id @default(uuid())
  clave       String  @unique
  valor       String
  descripcion String?
}

model Secuencia {
  clave String @id
  valor Int    @default(0)
}

model Producto {
  id           String   @id @default(uuid())
  nombre       String
  descripcion  String?
  categoria    String   @default("accesorio") // repuesto | accesorio
  sku          String?  @unique
  precioCompra Decimal  @default(0)
  precioVenta  Decimal
  stock        Int      @default(0)
  stockMinimo  Int      @default(0)
  activo       Boolean  @default(true)
  condicion    String   @default("nuevo") // nuevo | usado | permuta
  modelo       String?
  capacidad    String?
  color        String?
  imei         String?  @unique
  estadoEquipo String?
  ventaOrigen  Venta?   @relation("VentaPermuta", fields: [ventaOrigenId], references: [id], onDelete: SetNull)
  ventaOrigenId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movimientos     MovimientoStock[]
  ventaItems      VentaContadoItem[]
  reparacionItems ReparacionProducto[]

  @@index([categoria, activo])
  @@index([stock])
}

model MovimientoStock {
  id             String   @id @default(uuid())
  producto       Producto @relation(fields: [productoId], references: [id])
  productoId     String
  tipo           String // ingreso | egreso | ajuste | venta | reparacion | anulacion
  cantidad       Int // delta con signo
  motivo         String?
  referenciaTipo String?
  referenciaId   String?
  createdAt      DateTime @default(now())

  @@index([productoId, createdAt])
}

model VentaContado {
  id                 String    @id @default(uuid())
  codigoOperacion    String    @unique
  cliente            Cliente?  @relation(fields: [clienteId], references: [id])
  clienteId          String?
  total              Decimal
  metodoPago         String    @default("efectivo") // efectivo | transferencia | tarjeta | mixto
  montoEfectivo      Decimal   @default(0)
  montoTransferencia Decimal   @default(0)
  montoTarjeta       Decimal   @default(0)
  observaciones      String?
  fechaVenta         DateTime  @default(now())
  anulada            Boolean   @default(false)
  motivoAnulacion    String?
  fechaAnulacion     DateTime?
  createdAt          DateTime  @default(now())

  items VentaContadoItem[]

  @@index([fechaVenta])
  @@index([clienteId])
  @@index([anulada, fechaVenta])
  @@map("VentaProducto")
}

model VentaContadoItem {
  id             String       @id @default(uuid())
  venta          VentaContado @relation(fields: [ventaId], references: [id])
  ventaId        String
  producto       Producto?      @relation(fields: [productoId], references: [id])
  productoId     String?
  iphone         iPhone?        @relation(fields: [iphoneId], references: [id])
  iphoneId       String?
  iphoneVariant  IphoneVariant? @relation(fields: [colorId], references: [id])
  colorId        String?
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal

  @@index([ventaId])
  @@index([productoId])
  @@index([iphoneId])
  @@index([colorId])
  @@map("VentaProductoItem")
}

model Reparacion {
  id                  String    @id @default(uuid())
  codigoOperacion     String    @unique
  cliente             Cliente   @relation(fields: [clienteId], references: [id])
  clienteId           String
  equipo              String
  marca               String?
  modelo              String?
  claveEquipo         String?
  imei                String?
  color               String?
  almacenamiento      String?
  accesoriosRecibidos String?
  estadoFisico        String?
  falla               String
  diagnostico         String?
  presupuesto         Decimal   @default(0)
  montoFinal          Decimal?
  estado              String    @default("recibido")
  fechaIngreso        DateTime  @default(now())
  fechaPromesa        DateTime?
  fechaEntrega        DateTime?
  observaciones       String?
  anulada             Boolean   @default(false)
  motivoAnulacion     String?
  fechaAnulacion      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  repuestos ReparacionProducto[]
  pagos     PagoReparacion[]
  historial HistorialReparacion[]

  @@index([estado, fechaIngreso])
  @@index([clienteId])
}

model HistorialReparacion {
  id             String     @id @default(uuid())
  reparacion     Reparacion @relation(fields: [reparacionId], references: [id])
  reparacionId   String
  estadoAnterior String?
  estadoNuevo    String
  nota           String?
  fecha          DateTime   @default(now())

  @@index([reparacionId, fecha])
}

model ReparacionProducto {
  id              String     @id @default(uuid())
  reparacion      Reparacion @relation(fields: [reparacionId], references: [id])
  reparacionId    String
  producto        Producto   @relation(fields: [productoId], references: [id])
  productoId      String
  cantidad        Int
  precioUnitario  Decimal
  subtotal        Decimal
  anulada         Boolean    @default(false)
  motivoAnulacion String?
  fechaAnulacion  DateTime?
  createdAt       DateTime   @default(now())

  @@index([reparacionId])
  @@index([productoId])
  @@index([anulada, createdAt])
}

model PagoReparacion {
  id              String     @id @default(uuid())
  codigoOperacion String     @unique
  reparacion      Reparacion @relation(fields: [reparacionId], references: [id])
  reparacionId    String
  monto           Decimal
  metodoPago      String     @default("efectivo")
  concepto        String?
  fecha           DateTime   @default(now())
  observaciones   String?
  anulada         Boolean    @default(false)
  motivoAnulacion String?
  fechaAnulacion  DateTime?

  @@index([reparacionId, fecha])
  @@index([anulada, fecha])
}

model PagoCuota {
  id              String    @id @default(uuid())
  codigoOperacion String    @unique
  cuota           Cuota     @relation(fields: [cuotaId], references: [id])
  cuotaId         String
  monto           Decimal
  montoMora       Decimal   @default(0)
  metodoPago      String    @default("efectivo")
  fecha           DateTime  @default(now())
  observaciones   String?
  anulada         Boolean   @default(false)
  motivoAnulacion String?
  fechaAnulacion  DateTime?

  @@index([cuotaId, fecha])
  @@index([anulada, fecha])
}

model CajaDiaria {
  id                         String    @id @default(uuid())
  fechaDia                   DateTime  @unique
  montoInicial               Decimal   @default(0)
  estado                     String    @default("abierta") // abierta | cerrada
  abiertaAt                  DateTime  @default(now())
  cerradaAt                  DateTime?
  montoEsperadoEfectivo      Decimal?
  montoContadoEfectivo       Decimal?
  diferenciaEfectivo         Decimal?
  montoEsperadoTransferencia Decimal?
  montoContadoTransferencia  Decimal?
  diferenciaTransferencia    Decimal?
  observaciones              String?
  createdAt                  DateTime  @default(now())

  movimientos MovimientoCaja[]

  @@index([estado])
}

model MovimientoCaja {
  id                 String     @id @default(uuid())
  caja               CajaDiaria @relation(fields: [cajaId], references: [id])
  cajaId             String
  tipo               String // venta | venta_financiada | cobro_cuota | venta_producto | venta_iphone | cobro_reparacion | ingreso | egreso | ajuste | anulacion
  metodoPago         String     @default("efectivo") // efectivo | transferencia | tarjeta | mixto
  monto              Decimal
  montoEfectivo      Decimal    @default(0)
  montoTransferencia Decimal    @default(0)
  montoTarjeta       Decimal    @default(0)
  descripcion        String?
  codigoOperacion    String?
  referenciaTipo     String?
  referenciaId       String?
  createdAt          DateTime   @default(now())
  anulada            Boolean    @default(false)
  motivoAnulacion    String?
  fechaAnulacion     DateTime?

  @@index([cajaId, metodoPago])
  @@index([codigoOperacion])
  @@index([anulada, createdAt])
}

// ==========================================
// MÓDULO ARCA / AFIP (Facturación Electrónica)
// ==========================================

model Comprobante {
  id                   String          @id @default(uuid())
  ambiente             String          @default("homologacion") // homologacion | produccion
  ptoVta               Int
  cbteTipo             Int             // 1: A, 6: B, 11: C, etc.
  cbteNro              Int?            // Asignado por ARCA al autorizar
  cae                  String?         // CAE otorgado por AFIP
  caeFchVto            String?         // Vencimiento del CAE (YYYYMMDD)

  referenciaTipo       String?         // 'venta' | 'venta_contado' | 'reparacion' | etc.
  referenciaId         String?         // ID del registro asociado

  docTipo              Int             // 80: CUIT, 96: DNI, 99: Cons. Final, etc.
  docNro               String
  receptorNombre       String
  condicionIvaReceptor String          // Responsable Inscripto, Monotributo, Consumidor Final, etc.

  concepto             Int             @default(1) // 1: Productos, 2: Servicios, 3: Ambos
  fchServDesde         DateTime?
  fchServHasta         DateTime?
  fchVtoPago           DateTime?
  impTotal             Decimal
  impTotConc           Decimal         @default(0) // No gravado
  impNeto              Decimal         @default(0) // Gravado
  impOpEx              Decimal         @default(0) // Exento
  impTrib              Decimal         @default(0) // Tributos
  impIva               Decimal         @default(0) // IVA total

  estado               String          @default("pendiente") // pendiente | autorizado | rechazado | anulado
  intentos             Int             @default(0)
  resultado            String?         // A: Aprobado, R: Rechazado, P: Parcial
  observaciones        String?         // Mensajes o errores devueltos por ARCA
  requestJson          String?         // Payload enviado a AFIP para auditoría
  responseJson         String?         // Respuesta cruda recibida de AFIP

  cbteAsocTipo         Int?
  cbteAsocPtoVta       Int?
  cbteAsocNro          Int?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  ivas                 ComprobanteIva[]

  @@unique([ambiente, ptoVta, cbteTipo, cbteNro])
  @@index([referenciaTipo, referenciaId])
  @@index([estado, createdAt])
  @@map("comprobante")
}

model ComprobanteIva {
  id             String      @id @default(uuid())
  comprobanteId  String
  comprobante    Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  idIva          Int         // ID de alícuota en AFIP (5: 21%, 4: 10.5%, etc.)
  baseImp        Decimal     // Base imponible
  importe        Decimal     // Importe de IVA

  @@index([comprobanteId])
  @@map("comprobante_iva")
}

model ArcaToken {
  id         String   @id @default(uuid())
  ambiente   String   @unique @default("homologacion") // homologacion | produccion
  token      String   // Token CMS devuelto por AFIP / WSAA
  sign       String   // Sign firmado devuelto por AFIP / WSAA
  expiresAt  DateTime // Fecha de expiración (por lo general duran 12 horas)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("arca_token")
}